<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% for name, content in meta %}
<meta name="{{ name }}" content="{{ content }}">
{% endfor %}
{% if urls.landing_live %}<link rel="canonical" href="{{ urls.landing_live }}">{% endif %}
{% if license and license.url %}<link rel="license" href="{{ license.url }}">{% endif %}
<script type="application/ld+json">{{ jsonld }}</script>
<style>
:root { --primary: {{ colors.primary }}; --accent: {{ colors.accent }}; --rule: {{ colors.rule }}; --muted: {{ colors.muted }}; }
* { box-sizing: border-box; }
body { margin: 0; font: 17px/1.6 Georgia, "Libertinus Serif", "Times New Roman", serif; color: #1b1f24; background: #fff; }
a { color: var(--primary); }
a:focus-visible, [tabindex]:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.skip { position: absolute; left: -999px; } .skip:focus { left: 1rem; top: 1rem; background: #fff; padding: .4rem .8rem; z-index: 2; }
header.masthead { background: var(--primary); color: #fff; padding: .9rem 1.25rem; font-family: system-ui, sans-serif; }
header.masthead a { color: #fff; } header.masthead .issn { font-size: .8rem; opacity: .9; }
main { max-width: 52rem; margin: 0 auto; padding: 1.25rem 1.25rem 4rem; }
.type { color: var(--accent); font: 700 .8rem system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
.citeline { color: var(--muted); font: .85rem system-ui, sans-serif; }
h1.title { font-size: 1.9rem; line-height: 1.2; color: var(--primary); margin: .4rem 0 .6rem; }
.title-original { font-style: italic; color: var(--muted); margin-top: -.3rem; }
.authors { font-size: 1.05rem; } .affiliations, .dates, .corresp { font-size: .85rem; color: var(--muted); }
.affiliations ol { list-style: none; padding: 0; margin: .4rem 0; }
.orcid { font: 700 .62rem system-ui, sans-serif; background: #a6ce39; color: #fff; border-radius: 50%; padding: .12rem .22rem; text-decoration: none; vertical-align: super; }
section.abstract { background: color-mix(in srgb, var(--primary) 7%, #fff); padding: 1rem 1.2rem; border-radius: 4px; margin: 1.2rem 0; }
section.abstract h2 { margin-top: 0; }
h2, h3, h4 { color: var(--primary); line-height: 1.25; }
.links { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1rem 0; font-family: system-ui, sans-serif; }
.links a { border: 1px solid var(--primary); border-radius: 4px; padding: .45rem .9rem; text-decoration: none; font-weight: 600; }
.links a.primary { background: var(--primary); color: #fff; }
figure { margin: 1.5rem 0; } figure img { max-width: 100%; height: auto; }
figcaption { font-size: .9rem; } .label { font-weight: 700; color: var(--primary); }
.table-scroll { overflow-x: auto; } table { border-collapse: collapse; font: .85rem/1.4 system-ui, sans-serif; min-width: 100%; }
th, td { border-bottom: 1px solid var(--rule); padding: .35rem .5rem; text-align: left; vertical-align: top; }
thead th { border-bottom: 2px solid var(--primary); background: color-mix(in srgb, var(--primary) 8%, #fff); }
tbody th { font-weight: 400; }
.table-note { font-size: .8rem; color: var(--muted); }
.equation { display: flex; align-items: center; justify-content: center; gap: 2rem; margin: 1rem 0; overflow-x: auto; }
ol.references { padding-left: 2.2rem; font-size: .92rem; } ol.references li { margin-bottom: .35rem; }
.license { font-size: .85rem; color: var(--muted); border-top: 1px solid var(--rule); margin-top: 2rem; padding-top: 1rem; }
.watermark { background: #b3261e; color: #fff; padding: .5rem 1rem; font: 700 .9rem system-ui, sans-serif; text-align: center; }
@media print { .links, .skip { display: none; } }
</style>
