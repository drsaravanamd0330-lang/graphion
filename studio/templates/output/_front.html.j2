{% if watermark %}<div class="watermark" role="note">{{ watermark }}</div>{% endif %}
<header class="masthead">
  <div><a href="{{ journal.homepage or '#' }}"><strong>{{ journal.title }}</strong></a></div>
  <div class="issn">{% if journal.issn_print %}ISSN {{ journal.issn_print }} (Print){% endif %}{% if journal.issn_print and journal.issn_online %} · {% endif %}{% if journal.issn_online %}ISSN {{ journal.issn_online }} (Online){% endif %}{% if journal.publisher %} · {{ journal.publisher }}{% endif %}</div>
</header>
<main id="main">
<article>
<p class="type">{{ article_type }}</p>
<p class="citeline">{{ journal.abbreviation }}{% if pub.year %} {{ pub.year }}{% endif %}{% if pub.volume %};{{ pub.volume }}{% endif %}{% if pub.issue %}({{ pub.issue }}){% endif %}{% if locator %}:{{ locator }}{% endif %}{% if doi_url %} · <a href="{{ doi_url }}">{{ doi_url }}</a>{% endif %}</p>
<h1 class="title">{{ title }}</h1>
{% if title_original %}<p class="title-original" lang="{{ title_original_lang or '' }}">{{ title_original }}</p>{% endif %}
<p class="authors">{% for a in authors %}{{ a.name }}<sup>{{ a.sup }}{% if a.corresponding %}*{% endif %}</sup>{% if a.orcid %} <a class="orcid" href="https://orcid.org/{{ a.orcid }}" aria-label="ORCID iD for {{ a.name }}: {{ a.orcid }}">iD</a>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</p>
<div class="affiliations"><ol>{% for af in affiliations %}<li><sup>{{ af.label }}</sup> {{ af.raw }}</li>{% endfor %}</ol></div>
{% for a in authors if a.corresponding and a.email %}<p class="corresp">*Correspondence: {{ a.name }}, <a href="mailto:{{ a.email }}">{{ a.email }}</a></p>{% endfor %}
{% if dates %}<p class="dates">{% for k, v in dates %}{{ k }}: {{ v }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
<nav class="links" aria-label="Article formats">
  <a class="primary" href="article.pdf">Download PDF</a>
  <a href="fulltext.html">Full text (HTML)</a>
  <a href="index.html">Article page</a>
  {% for s in supplementary %}<a href="{{ s.url }}">{{ s.label }}</a>{% endfor %}
</nav>
{% if abstract %}
<section class="abstract" aria-labelledby="abstract-h">
<h2 id="abstract-h">Abstract</h2>
{% for s in abstract %}<p>{% if s.label %}<strong>{{ s.label }}:</strong> {% endif %}{{ s.html }}</p>{% endfor %}
{% if keywords %}<p><strong>Keywords:</strong> {{ keywords | join('; ') }}</p>{% endif %}
</section>
{% endif %}
